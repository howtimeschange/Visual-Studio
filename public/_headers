# Application files have stable names. Revalidate them after each release;
# keep Cloudflare's normal caching for images and the vendored browser bundle.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/lovart*
  Cache-Control: no-cache
/app.js
  Cache-Control: public, max-age=0, must-revalidate
/styles.css
  Cache-Control: public, max-age=0, must-revalidate
/js/*
  Cache-Control: public, max-age=0, must-revalidate
/css/*
  Cache-Control: public, max-age=0, must-revalidate
/admin/*
  Cache-Control: no-cache
/icons.svg
  Cache-Control: public, max-age=0, must-revalidate
